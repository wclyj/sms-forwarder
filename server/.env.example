# 至少 16 位随机字符串。占位符不能用于登录或上报。
API_TOKEN=change-me-to-a-long-random-string

# 企业微信群 → 添加群机器人 → 复制 Webhook 地址。不填则跳过。
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx

# SMTP。QQ 邮箱：smtp.qq.com / 465 / SMTP 授权码（不是登录密码）。不填则跳过。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@qq.com
SMTP_PASS=your-smtp-auth-code
MAIL_TO=you@example.com

# 可选。配置后历史记录写入 Upstash Redis，适合 Vercel。不填则只保存在内存。
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
