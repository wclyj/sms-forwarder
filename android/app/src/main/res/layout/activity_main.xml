<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <LinearLayout
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
      android:id="@+id/webhook"
      android:hint="企业微信群机器人 Webhook"
      android:inputType="textUri"
      android:singleLine="true"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <EditText
      android:id="@+id/device"
      android:hint="设备名称"
      android:singleLine="true"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="邮箱可以留空。要发邮件时再填下面几项。"
      android:textSize="13sp"/>
    <EditText
      android:id="@+id/smtpHost"
      android:hint="SMTP 服务器，如 smtp.qq.com"
      android:singleLine="true"
      android:layout_marginTop="8dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <EditText
      android:id="@+id/smtpPort"
      android:hint="端口，QQ/163 一般是 465"
      android:inputType="number"
      android:singleLine="true"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <EditText
      android:id="@+id/smtpUser"
      android:hint="发件邮箱"
      android:inputType="textEmailAddress"
      android:singleLine="true"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <EditText
      android:id="@+id/smtpPass"
      android:hint="SMTP 授权码，不是登录密码"
      android:inputType="textPassword"
      android:singleLine="true"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <EditText
      android:id="@+id/mailTo"
      android:hint="收件邮箱"
      android:inputType="textEmailAddress"
      android:singleLine="true"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <Button
      android:id="@+id/save"
      android:text="保存并启动"
      android:layout_marginTop="12dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <Button
      android:id="@+id/test"
      android:text="发送测试"
      android:layout_marginTop="8dp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>
    <TextView
      android:id="@+id/watch"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textSize="13sp"
      android:text="短信权限：检查中"/>
    <TextView
      android:id="@+id/lastSms"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="13sp"
      android:text="最近短信：还没有"/>
    <TextView
      android:id="@+id/lastForward"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textSize="13sp"
      android:text="最近转发：还没有"/>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:textSize="13sp"
      android:text="测试成功只说明邮箱通了。带验证码字样的短信会转发；只有一串4到8位数字的短短信也会转发。请允许短信权限，并把电池设为无限制。"/>
  </LinearLayout>
</ScrollView>
